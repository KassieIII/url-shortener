{
  "name": "url-shortener",
  "version": "0.1.0",
  "description": "Tiny URL shortener service with rate limiting and click analytics",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["url-shortener", "express", "typescript", "redis"],
  "author": "Kassym Yermakhanbet",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "nanoid": "^3.3.7",
    "zod": "^3.23.8",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
